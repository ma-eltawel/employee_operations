<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_employee_form_inherit" model="ir.ui.view">
            <field name="name">view employee form inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form//div[@name='button_box']" position="inside">
                    <button name="action_open_task" type="object" class="oe_stat_button" icon="fa-list-alt">
                        <div class="o_stat_info">
                            Tasks
                            <span class="o_stat_value">
                                <field name="task_count"/>
                            </span>
                        </div>
                    </button>
                    <button name="action_open_late_task" type="object" class="oe_stat_button" icon="fa-ban">
                        <div class="o_stat_info">
                            Late Tasks
                            <span class="o_stat_value">
                                <field name="late_task_count"/>
                            </span>
                        </div>
                    </button>
                    <button name="action_open_request" type="object" class="oe_stat_button" icon="fa-share-square">
                        <div class="o_stat_info">
                            Requests
                            <span class="o_stat_value">
                                <field name="request_count"/>
                            </span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>